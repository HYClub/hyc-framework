/* ===== Light Clean 主题 (NodeCanvas 浅色卡片风格) ===== */
.graphView {
    background-color: rgb(240, 240, 242);
}

.node {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-style: solid;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
}
.node:hover { border-color: rgb(80, 160, 240); box-shadow: 0 3px 10px rgba(0, 100, 200, 0.2); }
.node.selected { border-color: rgb(60, 140, 230); border-width: 2px; }
.node .title {
    color: rgb(40, 40, 40);
    font-size: 12px;
    -unity-font-style: bold;
    padding: 5px 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.bt-node-composite { border-color: rgb(80, 140, 220); }
.bt-node-composite .title { background-color: rgb(220, 232, 248); color: rgb(40, 80, 140); }

.bt-node-decorator { border-color: rgb(220, 180, 60); }
.bt-node-decorator .title { background-color: rgb(250, 240, 210); color: rgb(140, 105, 20); }

.bt-node-condition { border-color: rgb(220, 90, 90); }
.bt-node-condition .title { background-color: rgb(252, 225, 225); color: rgb(160, 40, 40); }

.bt-node-action { border-color: rgb(90, 180, 110); }
.bt-node-action .title { background-color: rgb(225, 245, 230); color: rgb(40, 130, 60); }

.bt-node-entry { border-color: rgb(150, 150, 160); }
.bt-node-entry .title { background-color: rgb(235, 235, 238); color: rgb(80, 80, 90); }

.bt-node-custom { border-color: rgb(150, 110, 210); }
.bt-node-custom .title { background-color: rgb(238, 230, 250); color: rgb(110, 60, 160); }

.port {
    background-color: rgb(200, 200, 210);
    border-width: 1px;
    border-style: solid;
    border-radius: 5px;
    width: 10px;
    height: 10px;
}
.port:hover { background-color: rgb(80, 160, 240); border-color: rgb(50, 120, 200); }

/* 运行状态高亮(调试) */
.bt-run-running {
    border-color: rgb(255, 200, 60) !important;
    border-width: 3px !important;
}
.bt-run-success {
    border-color: rgb(80, 220, 120) !important;
    border-width: 2px !important;
}
.bt-run-failed {
    border-color: rgb(255, 80, 80) !important;
    border-width: 2px !important;
}

/* 断点标记(右上角红点) */
.bt-breakpoint {
    border-color: rgb(255, 60, 60) !important;
    border-width: 2px !important;
}
.bt-breakpoint::before {
    content: "●";
    position: absolute;
    right: 4px;
    top: 4px;
    color: rgb(255, 60, 60);
    font-size: 14px;
}
