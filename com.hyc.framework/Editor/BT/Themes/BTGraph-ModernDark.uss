/* ===== Modern Dark 主题 (Unreal BT 暗色风格) ===== */
.graphView {
    background-color: rgb(37, 39, 46);
}

/* 节点基础 */
.node {
    background-color: rgb(52, 55, 64);
    border-width: 1px;
    border-style: solid;
    border-radius: 6px;
}
.node:hover { border-color: rgb(255, 200, 60); }
.node.selected { border-color: rgb(255, 180, 0); border-width: 2px; }
.node .title {
    color: rgb(235, 235, 235);
    font-size: 12px;
    -unity-font-style: bold;
    padding: 4px 8px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* 分类配色 */
.bt-node-composite {
    background-color: rgb(40, 70, 110);
    border-color: rgb(80, 140, 200);
}
.bt-node-composite .title { background-color: rgb(35, 60, 95); }

.bt-node-decorator {
    background-color: rgb(110, 90, 40);
    border-color: rgb(200, 170, 80);
}
.bt-node-decorator .title { background-color: rgb(90, 75, 35); }

.bt-node-condition {
    background-color: rgb(110, 45, 45);
    border-color: rgb(210, 90, 90);
}
.bt-node-condition .title { background-color: rgb(90, 38, 38); }

.bt-node-action {
    background-color: rgb(45, 100, 55);
    border-color: rgb(90, 190, 110);
}
.bt-node-action .title { background-color: rgb(38, 82, 46); }

.bt-node-entry {
    background-color: rgb(60, 60, 68);
    border-color: rgb(150, 150, 160);
}
.bt-node-entry .title { background-color: rgb(48, 48, 56); }

.bt-node-custom {
    background-color: rgb(70, 55, 95);
    border-color: rgb(150, 110, 200);
}
.bt-node-custom .title { background-color: rgb(58, 46, 78); }

/* 端口小圆点 */
.port {
    background-color: rgb(170, 170, 180);
    border-width: 1px;
    border-style: solid;
    border-radius: 5px;
    width: 10px;
    height: 10px;
}
.port:hover { background-color: rgb(255, 200, 60); border-color: rgb(200, 150, 30); }

/* 运行状态高亮(调试) */
.bt-run-running {
    border-color: rgb(255, 200, 60) !important;
    border-width: 3px !important;
}
.bt-run-success {
    border-color: rgb(80, 220, 120) !important;
    border-width: 2px !important;
}
.bt-run-failed {
    border-color: rgb(255, 80, 80) !important;
    border-width: 2px !important;
}

/* 断点标记(右上角红点) */
.bt-breakpoint {
    border-color: rgb(255, 60, 60) !important;
    border-width: 2px !important;
}
.bt-breakpoint::before {
    content: "●";
    position: absolute;
    right: 4px;
    top: 4px;
    color: rgb(255, 60, 60);
    font-size: 14px;
}

/* 迷你地图右上角 */
.bt-minimap {
    position: absolute;
    top: 44px;
    right: 8px;
}
