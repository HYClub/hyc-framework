{
    "name": "com.hyc.framework",
    "displayName": "HYC Framework",
    "version": "2.0.6",
    "unity": "2022.3",
    "description": "HYC Framework - 基于 Unity 2022.3 的 DOTS/ECS 数据驱动游戏框架：配置管线(模板/枚举/多语言Key/Blob)、多语言本地化、ECS UI、输入/热键、Timeline 过场与可视化行为树(BT)，配套完整编辑器工具链。",
    "keywords": [
        "hyc",
        "framework",
        "dots",
        "ecs",
        "config",
        "ui",
        "loc",
        "behaviour-tree",
        "input"
    ],
    "category": "HYC Framework",
    "documentationUrl": "https://github.com/HYClub/hyc-framework/blob/main/com.hyc.framework/README.md",
    "changelogUrl": "https://github.com/HYClub/hyc-framework/blob/main/com.hyc.framework/CHANGELOG.md",
    "licensesUrl": "https://github.com/HYClub/hyc-framework/blob/main/com.hyc.framework/LICENSE",
    "thirdPartyNoticesUrl": "https://github.com/HYClub/hyc-framework/blob/main/com.hyc.framework/Editor/Dlls/THIRD-PARTY-NOTICES.md",
    "samples": [
        {
            "displayName": "HYC Simple",
            "description": "HYC 框架最小可运行接入示例（属性 Attr / 配置 Config / 行为树 BT / 本地化 Loc / 场景串联）。导入后位于 Assets/Samples/com.hyc.framework/<版本>/HYCSimple/。",
            "path": "Samples~/HYCSimple"
        }
    ],
    "dependencies": {
        "com.unity.addressables": "1.21.21",
        "com.unity.nuget.newtonsoft-json": "3.2.1"
    }
}
