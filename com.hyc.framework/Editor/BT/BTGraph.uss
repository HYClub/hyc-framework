.graphView {
    background-color: rgb(42, 42, 42);
}

/* 节点 */
.node {
    background-color: rgb(62, 62, 68);
    border-color: rgb(120, 120, 130);
    border-width: 1px;
    border-style: solid;
    border-radius: 6px;
}

.node:hover {
    border-color: rgb(0, 160, 230);
}

.node.selected {
    border-color: rgb(0, 160, 230);
    border-width: 2px;
}

.node .title {
    background-color: rgb(48, 48, 54);
    color: rgb(240, 240, 240);
    font-size: 12px;
    -unity-font-style: bold;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px 8px;
}

/* 端口: 小圆点。尺寸=10 半径=5(圆角为一半), 细边框 */
.port {
    background-color: rgb(170, 170, 180);
    border-color: rgb(90, 90, 100);
    border-width: 1px;
    border-style: solid;
    border-radius: 5px;
    width: 10px;
    height: 10px;
    margin: 0 2px;
}

.port:hover {
    background-color: rgb(0, 160, 230);
    border-color: rgb(0, 120, 180);
}
